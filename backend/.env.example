# Desenvolvimento local: copie para .env e preencha os valores.
# Na Vercel, cadastre os valores em Settings > Environment Variables.
# Nunca coloque senhas ou tokens reais neste arquivo versionado.
ADMIN_PASSWORD=
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/radio.sqlite
NODE_ENV=development
# Se houver proxy reverso na mesma máquina: TRUST_PROXY=loopback

# Obrigatórios na Vercel; vazios usam SQLite local no desenvolvimento.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Opcional: identificador mostrado em Configuração > Banco de dados.
# Impede que um deploy abra outro banco por engano.
EXPECTED_DATABASE_ID=
